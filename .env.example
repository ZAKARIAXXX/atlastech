# ==============================================================================
# AtlasTech IT Operations Platform — Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and populate with your secure secrets.
# NEVER commit the actual '.env' file to version control.
# ==============================================================================

# Environment Mode: 'development', 'staging', 'production'
ATLASTECH_ENVIRONMENT=development

# Database Configuration (PostgreSQL 16)
POSTGRES_USER=atlastech
POSTGRES_PASSWORD=generate_a_strong_postgres_password_here
POSTGRES_DB=atlastech
ATLASTECH_DATABASE_URL=postgresql+asyncpg://atlastech:generate_a_strong_postgres_password_here@localhost:5432/atlastech

# Redis Configuration (Redis 7)
ATLASTECH_REDIS_PASSWORD=generate_a_strong_redis_password_here
ATLASTECH_REDIS_URL=redis://:generate_a_strong_redis_password_here@localhost:6379/0

# Security & Authentication (Must be >=32 characters in production)
ATLASTECH_JWT_SECRET_KEY=generate_a_random_32_byte_jwt_secret_key_here
ATLASTECH_JWT_ALGORITHM=HS256
ATLASTECH_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# API Key for Agent Telemetry Ingestion (Must be >=16 characters in production)
ATLASTECH_API_KEY=generate_a_secure_agent_api_key_here

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
